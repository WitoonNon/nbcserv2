# ---------------------------------------------------------------------------
# NBC Group Service Management — environment
# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
DATABASE_URL="postgresql://nbc:nbc@localhost:5432/nbc_service?schema=public"

# --- App ------------------------------------------------------------------
APP_URL="http://localhost:3000"
APP_TIMEZONE="Asia/Bangkok"
DEFAULT_LOCALE="th"

# --- Storage --------------------------------------------------------------
# @client-confirm G2 (hosting/PDPA). Adapter is swappable: local | s3 | supabase
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./.storage"

# Supabase Storage (used when STORAGE_DRIVER=supabase) — the same project that
# already hosts the database, so there is no second account to provision.
#
# The bucket MUST be private. Storage keys follow a predictable layout, so a
# public bucket would let anyone who guesses one look at photographs taken
# inside a customer's home. Access is only ever handed out as a signed URL.
#
# Create it once: Supabase → Storage → New bucket, and leave "Public bucket"
# OFF. The service-role key is under Settings → API and must never reach the
# browser (note the deliberate absence of a NEXT_PUBLIC_ prefix).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="work-orders"
SUPABASE_SIGNED_URL_TTL="3600"

# S3 / Cloudflare R2 (used when STORAGE_DRIVER=s3)
S3_ENDPOINT=""
S3_REGION="ap-southeast-1"
S3_BUCKET="nbc-service"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
NEXT_PUBLIC_MEDIA_HOST=""

# --- Notifications --------------------------------------------------------
# Adapter is swappable: console | line | email
NOTIFY_DRIVER="console"
# @client-confirm G3 — LINE Messaging API for @nbcservice
LINE_CHANNEL_ID=""
LINE_CHANNEL_SECRET=""
LINE_CHANNEL_ACCESS_TOKEN=""
# SMTP fallback
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="NBC Group <nbcservice@nbcgroup.co.th>"

# --- Auth -----------------------------------------------------------------
AUTH_SECRET="change-me-in-production"

# --- Queue (optional in dev) ---------------------------------------------
REDIS_URL="redis://localhost:6379"
