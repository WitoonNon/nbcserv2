// ---------------------------------------------------------------------------
// NBC Group — Service Management
// Base: datasource, generator, and enums shared across modules.
//
// Convention: values marked @client-confirm are placeholders chosen from the
// client's public site or standard practice. They live in DATA (seed rows /
// AppConfig), never in code, so they change without a migration.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/prisma"
}

// Prisma 7: the connection URL lives in prisma.config.ts (for the CLI) and is
// passed to PrismaClient via a driver adapter at runtime — see src/lib/db.
datasource db {
  provider = "postgresql"
}

// --- Service shape ---------------------------------------------------------

enum ServiceCategory {
  INSPECTION_REPAIR // ใบตรวจเช็ค/แจ้งซ่อม
  CLEANING_PM // ใบล้าง/PM
  REPAIR // ใบซ่อม
  INSTALLATION // ติดตั้ง (out of base scope, modelled for later)
}

/// @client-confirm C4 — the client must define their own size bands.
enum JobSize {
  S
  M
  L
  XL
}

enum AcType {
  WALL // แอร์ติดผนัง
  CEILING // แอร์แขวน
  STANDING // แอร์ตู้ตั้ง
  CASSETTE_4WAY // แอร์ฝังฝ้า 4 ทิศทาง
  CONCEALED_SMALL // แอร์ซ่อนในฝ้า (เล็ก)
  CONCEALED_LARGE // แอร์ซ่อนในฝ้า (ใหญ่)
  VRV_VRF
  AHU
  CHILLER
  OTHER
}

enum PricingTier {
  CONTRACT // ลูกค้าในสัญญา
  STANDARD // ลูกค้าทั่วไป
}

