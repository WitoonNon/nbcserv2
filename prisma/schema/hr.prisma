// ---------------------------------------------------------------------------
// People who work here
//
// Three tables already describe a person and none of them is a staff record.
// `User` is a login — it has a password and a role and no human being behind
// it. `Technician` is a dispatch capability — a skill level, a zone, a crew —
// and it exists only for people who go out on jobs, so the office staff and
// the owner have no row at all. Payroll needs a row for everyone.
//
// So `Employee` is the staff record, and it OWNS the employment facts: who
// this person is, what they are paid, when they started. `Technician` keeps
// only what dispatch needs and points here; the fields that overlapped
// (employeeCode, hiredAt, phone) belong to Employee now and Technician reads
// them through the relation rather than keeping a second copy that drifts.
//
// @client-confirm H1 — scope of the personnel file: the columns below cover
// what payroll cannot run without, plus identity. Scanned documents,
// qualifications, promotion and disciplinary history are deliberately absent
// pending the client's answer, and are additive when it comes.
// ---------------------------------------------------------------------------

enum EmploymentType {
  DAILY // ค่าแรงรายวัน
  MONTHLY // เงินเดือนรายเดือน
}

enum EmployeeStatus {
  PROBATION // ทดลองงาน
  ACTIVE // พนักงานประจำ
  ON_LEAVE // ลาระยะยาว
  RESIGNED // ลาออกแล้ว
}

model Employee {
  id     String  @id @default(cuid())
  /// Nullable on purpose: a labourer who never signs in still has to be paid.
  userId String? @unique

  employeeCode String @unique // EMP-001

  // --- Identity -----------------------------------------------------------
  titleTh     String? // นาย / นาง / นางสาว
  firstNameTh String
  lastNameTh  String
  nickname    String?

  /// เลขบัตรประชาชน — ENCRYPTED AT REST. Never store this in the clear and
  /// never put it in a log, a URL or a chart label. See lib/crypto/field.ts.
  nationalIdEnc   String?
  /// Last four digits, in the clear, so a record can be identified on screen
  /// and searched for without decrypting every row in the table.
  nationalIdLast4 String?

  birthDate DateTime? @db.Date
  phone     String?
  email     String?
  address   String? // ที่อยู่ตามทะเบียนบ้าน

  emergencyContactName  String?
  emergencyContactPhone String?
  emergencyContactRel   String? // ความสัมพันธ์

  // --- Employment ---------------------------------------------------------
  position   String // ตำแหน่ง
  department String? // แผนก

  employmentType EmploymentType @default(DAILY)
  status         EmployeeStatus @default(PROBATION)

  /// Baht per day for DAILY, per month for MONTHLY. Decimal, not Float:
  /// wages are money and binary floating point cannot hold 0.1.
  wageRate Decimal? @db.Decimal(12, 2)

  hiredAt        DateTime? @db.Date
  probationEndAt DateTime? @db.Date
  resignedAt     DateTime? @db.Date

  // --- Payment ------------------------------------------------------------
  bankName         String?
  /// เลขบัญชีธนาคาร — ENCRYPTED AT REST, same rules as nationalIdEnc.
  bankAccountEnc   String?
  /// Last four digits in the clear, so the office can confirm an account on
  /// screen against a passbook without exposing the whole number.
  bankAccountLast4 String?

  isActive  Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  technician   Technician?
  accessLogs   EmployeeAccessLog[]
  wageChanges  EmployeeWageChange[]
  timeClock    TimeClockEntry[]
  overtime     OvertimeRequest[]
  leave        LeaveRequest[]
  payrollLines PayrollLine[]

  @@index([status, isActive])
  @@index([lastNameTh, firstNameTh])
  @@map("employees")
}

/// Who opened whose personnel file.
///
/// Not kept for customer records, and required here. A personnel file holds a
/// national ID, a bank account and a salary; "who can see it" is a rule, and a
/// rule nobody can check afterwards is a hope. Written on reads of the
/// sensitive fields only — listing staff names is not an event worth storing.
model EmployeeAccessLog {
  id         String   @id @default(cuid())
  employeeId String
  /// The account that looked. Kept even if the account is later deleted, so
  /// the trail survives the leaver it might be about — hence no relation.
  actorId    String
  actorName  String
  /// 'view_sensitive' | 'edit' | 'export'
  action     String
  at         DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, at])
  @@index([actorId, at])
  @@map("employee_access_logs")
}

/// Every wage this person has been on, and from when.
///
/// `Employee.wageRate` is a single mutable column, which is fine for "what do
/// we pay them now" and wrong for everything else. Raise somebody on 15
/// September, then recalculate August's payroll on the 20th, and the run uses
/// the new rate — the wrong money, with nothing on screen to suggest it.
///
/// So the rate that applied during a period has to be a fact that survives the
/// next raise. This table is the source of truth for that; `Employee.wageRate`
/// stays as a denormalised "current" so the common read needs no join, and the
/// service writes both together.
///
/// The client asked for this as *"หมายเหตุ กรณีปรับค่าแรง"* — a notes field.
/// A single note would be overwritten by the next adjustment, which is exactly
/// the history they were asking to keep.
model EmployeeWageChange {
  id         String @id @default(cuid())
  employeeId String

  /// The wage applies from this date onward. Date, not timestamp: payroll
  /// periods are calendar days and a mid-day boundary has no meaning here.
  effectiveFrom DateTime @db.Date

  wageRate       Decimal        @db.Decimal(12, 2)
  employmentType EmploymentType
  /// What it was before — kept so the row reads on its own without having to
  /// find and subtract the previous one.
  previousRate   Decimal?       @db.Decimal(12, 2)

  /// "ปรับตามผลงานประจำปี", "ผ่านทดลองงาน" — the client's หมายเหตุ.
  reason String?

  /// Who recorded it. Name is copied rather than joined so the trail still
  /// reads after an account is deleted.
  recordedById   String
  recordedByName String
  createdAt      DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// One rate per start date per person — a second row for the same day makes
  /// "what were they on that day" ambiguous, and payroll cannot be ambiguous.
  @@unique([employeeId, effectiveFrom])
  @@index([employeeId, effectiveFrom])
  @@map("employee_wage_changes")
}

// ---------------------------------------------------------------------------
// Time clock — ลงเวลาเข้า-ออก
//
// The client's rule, agreed 26 ส.ค.: a QR code printed and fixed to the wall,
// with the location check as the actual anti-fraud measure. A printed code is
// photographed and shared within the first week; coordinates are what tie a
// punch to a place.
//
// The corollary matters as much: a location check NEVER refuses a punch. A
// phone with location off, an old handset, a basement car park — none of that
// is the employee's fault, and an employee who cannot clock in does not get
// paid. Every punch is recorded; a doubtful one is flagged for a supervisor.
// ---------------------------------------------------------------------------

enum TimeClockKind {
  IN
  OUT
}

/// What the location check concluded. Mirrors GeofenceVerdict in
/// src/modules/hr/geofence.ts, which is where the rule is written and tested.
enum GeofenceVerdict {
  INSIDE
  OUTSIDE
  /// The phone reported no usable position.
  NO_FIX
  /// Nominally inside, but the phone's own margin of error was wider than the
  /// fence — so "inside" carried no information.
  UNRELIABLE
}

model TimeClockEntry {
  id         String        @id @default(cuid())
  employeeId String
  kind       TimeClockKind

  /// Server time, deliberately. Elsewhere in this system a client timestamp is
  /// accepted because offline it is the only record of the real moment — but
  /// this one decides what somebody is paid, and a device clock the employee
  /// controls must not be the authority on that.
  occurredAt DateTime @default(now())

  /// Which code was scanned, and which kind it was.
  scanPointId String
  tokenKind   String // STATIC | ROTATING

  lat            Float?
  lng            Float?
  accuracyMetres Float?
  geofence       GeofenceVerdict
  /// Distance from the scan point. Null when there was no fix to measure.
  distanceMetres Int?

  /// Set for anything a supervisor should look at. Cleared by reviewing it,
  /// never by the employee.
  needsReview  Boolean   @default(false)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?

  deviceInfo String?
  createdAt  DateTime @default(now())

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewedBy User?    @relation("TimeClockReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  /// The main read: one person's day, in order.
  @@index([employeeId, occurredAt])
  /// The supervisor's queue.
  @@index([needsReview, occurredAt])
  @@map("time_clock_entries")
}

// ---------------------------------------------------------------------------
// Overtime, leave and payroll — งานเพิ่ม 10,000
//
// Three rules from the client that the shapes below exist to hold:
//
//   1. Overtime is REQUESTED and APPROVED before it is paid. The approval
//      chain is borrowed from the work order: submitted, approved or returned
//      with a reason, and never editable once approved.
//   2. Overtime rates may not fall below the statutory multipliers. The
//      multiplier is stored per line so a payslip can be re-read years later
//      without depending on today's configuration.
//   3. A closed payroll period LOCKS. A figure that can be quietly amended
//      after the money has gone out is a figure nobody can audit.
// ---------------------------------------------------------------------------

/// Shared by overtime and leave: both are somebody asking and somebody
/// deciding, and both need the same three answers.
enum HrRequestStatus {
  PENDING
  APPROVED
  REJECTED
  /// Withdrawn by the person who asked, before anyone decided.
  CANCELLED
}

enum OvertimeKind {
  /// เกินเวลาทำงานปกติในวันทำงาน — ม.61, ขั้นต่ำ 1.5 เท่า
  WORKDAY_OT
  /// ทำงานในวันหยุด — ม.62, ขั้นต่ำ 2 เท่า
  HOLIDAY_WORK
  /// เกินเวลาทำงานปกติในวันหยุด — ม.63, ขั้นต่ำ 3 เท่า
  HOLIDAY_OT
}

enum LeaveType {
  SICK // ลาป่วย
  PERSONAL // ลากิจ
  ANNUAL // ลาพักร้อน
  UNPAID // ลาไม่รับค่าจ้าง
}

model OvertimeRequest {
  id         String          @id @default(cuid())
  employeeId String
  workDate   DateTime        @db.Date
  kind       OvertimeKind
  hours      Decimal         @db.Decimal(5, 2)
  reason     String
  status     HrRequestStatus @default(PENDING)

  /// Frozen at approval, not read from configuration at payroll time. A
  /// payslip reissued in two years has to show the rate that was actually
  /// paid, and the configured rate may have moved since.
  approvedMultiplier Decimal? @db.Decimal(4, 2)

  decidedById  String?
  decidedAt    DateTime?
  /// Why it was refused. Required to reject — "no" without a reason is not a
  /// decision anybody can act on.
  decisionNote String?

  /// Set when a payroll run has paid this. Blocks a second payment and blocks
  /// editing after the fact.
  paidInPeriodId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee  Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  decidedBy User?          @relation("OvertimeDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  period    PayrollPeriod? @relation(fields: [paidInPeriodId], references: [id], onDelete: SetNull)

  @@index([employeeId, workDate])
  @@index([status, workDate])
  @@map("overtime_requests")
}

model LeaveRequest {
  id         String          @id @default(cuid())
  employeeId String
  type       LeaveType
  fromDate   DateTime        @db.Date
  toDate     DateTime        @db.Date
  reason     String
  status     HrRequestStatus @default(PENDING)

  /// Split at approval and frozen. The entitlement is consumed as it is
  /// granted, so two requests decided on the same day cannot both be paid out
  /// of the last remaining day.
  totalDays  Decimal @db.Decimal(5, 2)
  paidDays   Decimal @default(0) @db.Decimal(5, 2)
  unpaidDays Decimal @default(0) @db.Decimal(5, 2)

  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?

  countedInPeriodId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee  Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  decidedBy User?          @relation("LeaveDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  period    PayrollPeriod? @relation(fields: [countedInPeriodId], references: [id], onDelete: SetNull)

  @@index([employeeId, fromDate])
  @@index([status, fromDate])
  @@map("leave_requests")
}

enum PayrollPeriodStatus {
  DRAFT
  /// Closed and locked. Payslips may only be issued from here.
  CLOSED
}

model PayrollPeriod {
  id     String              @id @default(cuid())
  /// "2569-09". One period per month; unique so a run cannot be duplicated.
  code   String              @unique
  from   DateTime            @db.Date
  to     DateTime            @db.Date
  status PayrollPeriodStatus @default(DRAFT)

  closedById String?
  closedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  closedBy User?             @relation("PayrollClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  lines    PayrollLine[]
  overtime OvertimeRequest[]
  leave    LeaveRequest[]

  @@index([status, from])
  @@map("payroll_periods")
}

model PayrollLine {
  id         String @id @default(cuid())
  periodId   String
  employeeId String

  /// Snapshotted at calculation. The wage record could be corrected later,
  /// and a payslip has to keep saying what was actually paid.
  wageRate       Decimal        @db.Decimal(12, 2)
  employmentType EmploymentType

  daysWorked      Decimal @default(0) @db.Decimal(5, 2)
  paidLeaveDays   Decimal @default(0) @db.Decimal(5, 2)
  unpaidLeaveDays Decimal @default(0) @db.Decimal(5, 2)
  overtimeHours   Decimal @default(0) @db.Decimal(6, 2)

  /// All amounts in satang, as integers. Money computed in floating-point
  /// baht drifts across a month of lines.
  baseSatang       Int @default(0)
  overtimeSatang   Int @default(0)
  additionsSatang  Int @default(0)
  deductionsSatang Int @default(0)
  netSatang        Int @default(0)

  /// [{ label, amountSatang }] — what the office added or took off by hand.
  additions  Json?
  deductions Json?

  /// True when an overtime line had to be raised to the statutory minimum.
  /// Printed on the payslip rather than silently corrected.
  raisedToLegalMinimum Boolean @default(false)

  /// Why this person could not be calculated — no wage on record, most often.
  /// A line that exists and explains itself beats a person quietly missing
  /// from the run.
  blockedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  period   PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([periodId, employeeId])
  @@index([periodId])
  @@map("payroll_lines")
}
